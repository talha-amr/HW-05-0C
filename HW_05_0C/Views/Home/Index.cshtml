@model HW_05_0C.Models.ViewModels.HomeViewModel

@section Styles {
    <style>
        .book-card {
            border: 1px solid #ccc;
            padding: 15px;
            margin-bottom: 20px;
            border-radius: 5px;
        }
    </style>
}

<h2>Book Catalog</h2>

@if (Model.Books.Count == 0)
{
    <div class="alert alert-warning">No books available</div>
}
else
{
    <div class="row">
        @foreach (var book in Model.Books)
        {
            <div class="col-md-4">
                <div class="book-card">
                    <h4>@book.Title</h4>
                    <p><strong>Author:</strong> @book.AuthorName</p>
                    <p><strong>Price:</strong> Rs. @book.Price</p>

                    <form action="/Home/RemoveBook" method="post" onsubmit="return confirmRemove();">
                        <input type="hidden" name="id" value="@book.Id" />
                        <button type="submit" class="btn btn-danger btn-sm">Remove</button>
                    </form>
                </div>
            </div>
        }
    </div>
}

<hr />

<div class="row mt-4">
    <div class="col-md-6">
        <div class="card p-3 bg-light">
            <h3>Add New Book</h3>
            <form action="/Home/AddBook" method="post">
                <div class="mb-3">
                    <label>Title</label>
                    <input type="text" name="Title" class="form-control" />
                </div>
                <div class="mb-3">
                    <label>Price</label>
                    <input type="number" step="0.01" name="Price" class="form-control" />
                </div>
                <div class="mb-3">
                    <label>Author</label>
                    <select name="AuthorId" class="form-control">
                        @foreach (var author in Model.Authors)
                        {
                            <option value="@author.Id">@author.Name</option>
                        }
                    </select>
                </div>
                <button type="submit" class="btn btn-primary">Add Book</button>
            </form>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card p-3 bg-light">
            <h3>Add New Author</h3>
            <form action="/Home/AddAuthor" method="post">
                <div class="mb-3">
                    <label>Name</label>
                    <input type="text" name="Name" class="form-control" />
                </div>
                <div class="mb-3">
                    <label>Country</label>
                    <input type="text" name="Country" class="form-control" />
                </div>
                <button type="submit" class="btn btn-success">Add Author</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmRemove() {
            return confirm("Remove this book?");
        }
    </script>
}